<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/overscan_h"
    android:paddingTop="@dimen/overscan_v"
    android:paddingEnd="@dimen/overscan_h"
    android:paddingBottom="@dimen/overscan_v">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/first_run_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_first_run"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/host_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:hint="@string/settings_host_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:nextFocusRight="@+id/label_input"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/label_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="0.6"
            android:background="@drawable/bg_focusable"
            android:hint="@string/settings_label_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/add_button"
            style="@style/Widget.TelePropia.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/settings_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_hosts_title"
        android:textColor="@color/text"
        android:textSize="20sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/host_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />

        <TextView
            android:id="@+id/empty_hosts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_no_hosts"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
