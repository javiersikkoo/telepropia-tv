{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ventana principal: pantalla completa y HTTP hacia los hosts que se den de alta en ajustes.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" },
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
